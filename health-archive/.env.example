LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 本地服务
HOST=127.0.0.1
PORT=8765

# 产品名（界面汉化显示）
APP_NAME=VitaRing
APP_TAGLINE=个人健康全景 · 随手记症状 · AI 读你自己的时间线

# 登录（复制为 .env 后即可用）
